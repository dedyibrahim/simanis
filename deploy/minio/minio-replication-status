#!/usr/bin/env bash
set -Eeuo pipefail

STATUS_FILE=/var/lib/simanis-ha/minio-flatten-status.json
PREFIXES=(berkasclient berkaslegalisasis berkasnotaris berkasppat berkaswarmerkings chat_attachments scanned-documents suratnotaris suratppats tandaterima)
source /etc/default/minio
mc alias set node10 http://192.168.0.10:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD" >/dev/null
mc alias set node11 http://192.168.0.11:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD" >/dev/null

if ip -4 addr show | grep -q '192\.168\.0\.12/'; then
  local_ip=$(hostname -I | tr ' ' '\n' | grep -E '^192\.168\.0\.(10|11)$' | head -1)
else
  local_ip=""
fi
if [[ "$local_ip" == "192.168.0.11" ]]; then
  source_alias=node11; source_server='MinIO server2'; source_ip='192.168.0.11'
  target_alias=node10; destination_server='MinIO server1'; destination_ip='192.168.0.10'
else
  source_alias=node10; source_server='MinIO server1'; source_ip='192.168.0.10'
  target_alias=node11; destination_server='MinIO server2'; destination_ip='192.168.0.11'
fi

running=false
if pgrep -f 'mc mirror .*node(10|11)/simanis-documents' >/dev/null; then running=true; fi
status=completed
if [[ "$running" == true ]]; then status=running; fi
current_prefix=""
command_line="$(pgrep -a -x mc | grep -E 'mirror .*node(10|11)/simanis-documents' | head -1 || true)"
if [[ -n "$command_line" ]]; then current_prefix="$(printf '%s' "$command_line" | sed -n 's/.*simanis-documents\/\([^ ]*\).*/\1/p')"; fi

du_json() {
  local output
  if output="$(mc du --json "$1" 2>/dev/null | tail -1)" && [[ "$output" == \{* ]]; then
    printf '%s\n' "$output"
  else
    printf '%s\n' '{"size":0,"objects":0,"status":"empty"}'
  fi
}
source_json="$(du_json "$source_alias/simanis-documents")"
destination_json="$(du_json "$target_alias/simanis-documents")"
source_bytes=$(php -r '$d=json_decode($argv[1],true)?:[]; echo (int)($d["size"]??0);' "$source_json")
destination_bytes=$(php -r '$d=json_decode($argv[1],true)?:[]; echo (int)($d["size"]??0);' "$destination_json")
source_objects=$(php -r '$d=json_decode($argv[1],true)?:[]; echo (int)($d["objects"]??0);' "$source_json")
destination_objects=$(php -r '$d=json_decode($argv[1],true)?:[]; echo (int)($d["objects"]??0);' "$destination_json")
prefixes='[]'
for prefix in "${PREFIXES[@]}"; do
  s="$(du_json "$source_alias/simanis-documents/$prefix")"
  d="$(du_json "$target_alias/simanis-documents/$prefix")"
  sb=$(php -r '$d=json_decode($argv[1],true)?:[];echo (int)($d["size"]??0);' "$s")
  db=$(php -r '$d=json_decode($argv[1],true)?:[];echo (int)($d["size"]??0);' "$d")
  so=$(php -r '$d=json_decode($argv[1],true)?:[];echo (int)($d["objects"]??0);' "$s")
  do=$(php -r '$d=json_decode($argv[1],true)?:[];echo (int)($d["objects"]??0);' "$d")
  ps=waiting
  if (( so > 0 && so == do && sb == db )); then ps=completed; elif [[ "$prefix" == "$current_prefix" || $do -gt 0 ]]; then ps=running; fi
  prefixes=$(php -r '$a=json_decode($argv[1],true)?:[];$a[]=["name"=>$argv[2],"status"=>$argv[3],"source_bytes"=>(int)$argv[4],"destination_bytes"=>(int)$argv[5],"source_objects"=>(int)$argv[6],"destination_objects"=>(int)$argv[7]];echo json_encode($a);' "$prefixes" "$prefix" "$ps" "$sb" "$db" "$so" "$do")
done
percent=$(php -r '$s=max(1,(int)$argv[1]);echo min(100,round((int)$argv[2]/$s*100,2));' "$source_bytes" "$destination_bytes")
if [[ "$running" == false && "$destination_objects" == "$source_objects" && "$source_bytes" == "$destination_bytes" ]]; then percent=100; fi
tmp="$STATUS_FILE.tmp"
php -r '$d=["status"=>$argv[1],"progress_percent"=>(float)$argv[2],"source_bytes"=>(int)$argv[3],"destination_bytes"=>(int)$argv[4],"source_objects"=>(int)$argv[5],"destination_objects"=>(int)$argv[6],"current_prefix"=>$argv[7],"process_running"=>$argv[8]==="true","updated_at"=>gmdate("c"),"prefixes"=>json_decode($argv[9],true)?:[],"source_server"=>$argv[10],"source_ip"=>$argv[11],"destination_server"=>$argv[12],"destination_ip"=>$argv[13],"error"=>""];file_put_contents($argv[14],json_encode($d));' "$status" "$percent" "$source_bytes" "$destination_bytes" "$source_objects" "$destination_objects" "$current_prefix" "$running" "$prefixes" "$source_server" "$source_ip" "$destination_server" "$destination_ip" "$tmp"
mv -f "$tmp" "$STATUS_FILE"
