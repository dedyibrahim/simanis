# SIMANIS Docker VPS template.
# Copy ke .env lalu isi nilai yang masih placeholder.

COMPOSE_PROJECT_NAME=simanis
SIMANIS_HTTP_PORT=80
SIMANIS_TIMEZONE=Asia/Jakarta
SIMANIS_APP_URL=http://localhost
APP_URL=http://localhost

# Ganti saat install. install.sh bisa generate nilai aman untuk field ini.
APP_KEY=
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=simanis
MYSQL_USER=simanis
MYSQL_PASSWORD=change-me-db
REDIS_PASSWORD=
INTERNAL_API_KEY=change-me-internal

# Frontend public config. Untuk single VPS, gunakan same-origin.
NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_ASSET_BASE=

# Laravel
APP_NAME=SIMANIS
APP_ENV=production
APP_DEBUG=false
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=simanis
DB_USERNAME=simanis
DB_PASSWORD=change-me-db
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
FILESYSTEM_DISK=local
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SESSION_DOMAIN=

# WhatsApp Gateway / WAHA
WAHA_ENABLED=true
WAHA_DRIVER=official
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=change-me-waha
WAHA_SESSION=default
WAHA_FORCE_DEFAULT_SESSION=true
WAHA_WEBHOOK_URL=http://bothwa:8020/webhook/waha
WAHA_WEBHOOK_SECRET=change-me-webhook
WAHA_WEBHOOK_AUTO_CONFIGURE=true
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me-dashboard

# bothWA
BOT_API_KEY=change-me-internal
LARAVEL_API_KEY=change-me-internal
LARAVEL_BASE_URL=http://api
BOT_PUBLIC_URL=
KTP_OCR_BASE_URL=http://ktp-ocr:8765
KTP_OCR_CONFIG=paddleocr-roi-balanced.json
KTP_OCR_ENGINE=paddleocr
KTP_OCR_TIMEOUT_MS=90000
GARIS_AKTA_BASE_URL=http://garis-akta:8788
GARIS_AKTA_TIMEOUT_MS=300000
DISPLAY_TIMEZONE=Asia/Jakarta

# Google Calendar optional
GOOGLE_CALENDAR_SYNC_ENABLED=false
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CREDENTIALS=
GOOGLE_CALENDAR_TIMEZONE=Asia/Jakarta
GOOGLE_CALENDAR_SYNC_ONLY_ON_VIP=false
