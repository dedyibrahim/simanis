<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^garis-otomatis-akta(/.*)?$ - [R=404,L]

  RewriteRule ^pekerjaan(/.*)?$ - [R=404,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ 200.html [L]
</IfModule>

# Revalidate entry pages after deployments; hashed assets keep their normal cache policy.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
