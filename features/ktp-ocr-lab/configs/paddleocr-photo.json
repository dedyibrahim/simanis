{
  "name": "paddleocr-photo",
  "description": "Preset PaddleOCR untuk foto KTP berwarna tanpa preprocessing agresif.",
  "preprocessing": {
    "resize_scale": 1.0,
    "grayscale": false,
    "denoise": false,
    "sharpen": false,
    "contrast": "none",
    "threshold": "none",
    "deskew": false
  },
  "ocr": {
    "engine": "paddleocr",
    "language": "en",
    "max_width": 900
  },
  "parser": {
    "normalize_labels": true,
    "strict_nik": true
  }
}
