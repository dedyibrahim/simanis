{
  "name": "tesseract-fast",
  "description": "Preset cepat untuk web: OCR foto + ROI NIK + satu ROI field kiri.",
  "preprocessing": {
    "resize_scale": 1.0,
    "grayscale": false,
    "denoise": false,
    "sharpen": false,
    "contrast": "none",
    "threshold": "none",
    "deskew": false
  },
  "ocr": {
    "engine": "tesseract",
    "language": "eng",
    "psm": 4,
    "oem": 3,
    "multi_pass": true,
    "roi_scales": [2],
    "roi_psms": [11],
    "max_width": 900
  },
  "parser": {
    "normalize_labels": true,
    "strict_nik": true
  }
}
