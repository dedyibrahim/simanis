{
  "name": "tesseract-photo",
  "description": "Preset Tesseract minim preprocessing untuk foto KTP yang sudah cukup tajam.",
  "preprocessing": {
    "resize_scale": 1.0,
    "grayscale": false,
    "denoise": false,
    "sharpen": false,
    "contrast": "none",
    "threshold": "none",
    "deskew": false
  },
  "ocr": {
    "engine": "tesseract",
    "language": "eng",
    "psm": 4,
    "oem": 3
  },
  "parser": {
    "normalize_labels": true,
    "strict_nik": true
  }
}

