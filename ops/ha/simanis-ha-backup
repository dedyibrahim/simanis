#!/usr/bin/env bash
set -euo pipefail

VIP="${SIMANIS_VIP:-192.168.0.12}"
LOCK_FILE="/run/lock/simanis-ha-role.lock"
mkdir -p "$(dirname "$LOCK_FILE")"
exec 9>"$LOCK_FILE"
flock -x 9

for _ in $(seq 1 30); do
    mysqladmin --defaults-extra-file=/root/.my.cnf ping --silent && break
    sleep 2
done

if ! mysqladmin --defaults-extra-file=/root/.my.cnf ping --silent; then
    logger -t simanis-ha "Transisi BACKUP dibatalkan karena MySQL belum siap"
    exit 1
fi

if ip -4 addr show | grep -q "${VIP}/"; then
    logger -t simanis-ha "Transisi BACKUP stale diabaikan karena server masih memegang VIP ${VIP}"
    exit 0
fi

if [[ -x /usr/local/sbin/simanis-bothwa-stop ]]; then
    /usr/local/sbin/simanis-bothwa-stop >/dev/null 2>&1 \
        && logger -t simanis-ha "WhatsApp Gateway dihentikan pada BACKUP" \
        || logger -t simanis-ha "Gagal menghentikan WhatsApp Gateway pada BACKUP"
fi

MYSQL=(mysql --defaults-extra-file=/root/.my.cnf)
REPL_USER="notaris"
REPL_PASSWORD="${SIMANIS_REPL_PASSWORD:?SIMANIS_REPL_PASSWORD wajib diisi}"

case "$(hostname)" in
    server1)
        MASTER_HOST="192.168.0.11"
        ;;
    server2)
        MASTER_HOST="192.168.0.10"
        ;;
    *)
        MASTER_HOST=""
        ;;
esac

"${MYSQL[@]}" -e "SET GLOBAL super_read_only=OFF; SET GLOBAL read_only=OFF;"

if [[ -n "$MASTER_HOST" ]]; then
    "${MYSQL[@]}" -e "STOP SLAVE" 2>/dev/null || true
    "${MYSQL[@]}" -e "RESET SLAVE ALL" 2>/dev/null || true
    "${MYSQL[@]}" -e "CHANGE MASTER TO MASTER_HOST='${MASTER_HOST}', MASTER_USER='${REPL_USER}', MASTER_PASSWORD='${REPL_PASSWORD}', MASTER_PORT=3306, MASTER_AUTO_POSITION=1"

    if "${MYSQL[@]}" -e "START SLAVE"; then
        logger -t simanis-ha "Server menjadi BACKUP, slave diarahkan ke ${MASTER_HOST}"
    else
        logger -t simanis-ha "Server menjadi BACKUP, tetapi START SLAVE ke ${MASTER_HOST} gagal. Cek GTID/replikasi manual."
    fi
else
    logger -t simanis-ha "Server menjadi BACKUP, hostname tidak dikenali untuk konfigurasi slave otomatis"
fi

"${MYSQL[@]}" -e "SET GLOBAL read_only=ON; SET GLOBAL super_read_only=ON;"
"${MYSQL[@]}" -NBe "SELECT @@read_only, @@super_read_only" | grep -q $'1\t1'
logger -t simanis-ha "Server menjadi BACKUP dan database dikunci read-only"
